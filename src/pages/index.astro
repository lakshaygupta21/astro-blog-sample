---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero animate-fade-in">
				<div class="hero-content">
					<span class="badge">Innovation 2025</span>
					<h1 class="gradient-text">Designing the <br/> Future of Web</h1>
					<p class="description">
						{SITE_DESCRIPTION}
					</p>
					<div class="cta-group">
						<a href="/blog" class="btn btn-primary">Insights & GuideS</a>
						<a href="/about" class="btn btn-outline">Network</a>
					</div>
				</div>
				<div class="hero-visual">
					<div class="glow-sphere"></div>
				</div>
			</section>

			<section class="features">
				<div class="section-header">
					<h2>Modern Excellence</h2>
					<p>Dedicated to pure performance and human-centric design patterns.</p>
				</div>
				<div class="grid">
					<div class="card">
						<div class="icon">⚡</div>
						<h3>Speed</h3>
						<p>Optimized for instantaneous interaction and world-class performance metrics.</p>
					</div>
					<div class="card">
						<div class="icon">🌓</div>
						<h3>Clarity</h3>
						<p>High-contrast, accessible designs that prioritize content and user focus.</p>
					</div>
					<div class="card">
						<div class="icon">📦</div>
						<h3>Resilience</h3>
						<p>Engineered for longevity with a focus on stable, modern web standards.</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6rem 0;
		gap: 4rem;
	}
	.hero-content {
		max-width: 600px;
	}
	.badge {
		background: rgba(0, 128, 128, 0.1);
		color: var(--primary);
		padding: 0.5rem 1rem;
		border-radius: 100px;
		font-size: 0.875rem;
		font-weight: 600;
		margin-bottom: 2rem;
		display: inline-block;
		border: 1px solid rgba(0, 128, 128, 0.2);
	}
	.hero h1 {
		margin-bottom: 1.5rem;
		line-height: 1.1;
	}
	.description {
		font-size: 1.25rem;
		color: var(--text-muted);
		margin-bottom: 3rem;
		line-height: 1.6;
	}
	.cta-group {
		display: flex;
		gap: 1.5rem;
	}
	.btn {
		padding: 1rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		transition: var(--transition);
		display: inline-block;
	}
	.btn-primary {
		background: var(--primary);
		color: white;
	}
	.btn-primary:hover {
		background: var(--primary-hover);
		transform: translateY(-2px);
		box-shadow: 0 10px 15px -3px rgba(0, 128, 128, 0.4);
	}
	.btn-outline {
		border: 1px solid var(--border);
		color: var(--text);
	}
	.btn-outline:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: var(--text);
	}

	.hero-visual {
		position: relative;
		flex-grow: 1;
		display: flex;
		justify-content: flex-end;
	}
	.glow-sphere {
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, var(--primary) 0%, var(--secondary) 100%);
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.3;
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-20px); }
	}

	.features {
		padding: 8rem 0;
	}
	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}
	.section-header h2 {
		font-size: 2.5rem;
	}
	.section-header p {
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	.icon {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}
	.card h3 {
		margin-bottom: 1rem;
	}
	.card p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	@media (max-width: 968px) {
		.hero {
			flex-direction: column;
			text-align: center;
			padding: 4rem 0;
		}
		.cta-group {
			justify-content: center;
		}
		.hero-visual {
			display: none;
		}
	}
</style>
