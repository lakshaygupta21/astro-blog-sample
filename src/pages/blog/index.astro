---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog • ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header animate-fade-in">
				<h1 class="gradient-text">Latest Insights</h1>
				<p>Exploring the frontier of AI, security, and digital validation.</p>
			</section>

			<section class="posts-grid">
				{
					posts.map((post, index) => (
						<article class={`post-card ${index === 0 ? 'featured' : ''}`}>
							<a href={`/blog/${post.id}/`}>
								<div class="image-wrapper">
									<img src={post.data.heroImage} alt={post.data.title} />
								</div>
								<div class="content">
									<div class="meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h2 class="title">{post.data.title}</h2>
									<p class="excerpt">{post.data.description}</p>
									<span class="read-more">Read Post →</span>
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-header {
		text-align: center;
		margin-bottom: 5rem;
	}
	.blog-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
	}
	.blog-header p {
		color: var(--text-muted);
		font-size: 1.25rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 3rem;
	}

	.post-card {
		background: var(--surface);
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		overflow: hidden;
		transition: var(--transition);
	}

	.post-card.featured {
		grid-column: 1 / -1;
		display: flex;
		background: var(--surface-glass);
		backdrop-filter: blur(10px);
	}

	.post-card .image-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.post-card.featured .image-wrapper {
		width: 60%;
		aspect-ratio: auto;
	}

	.post-card.featured .content {
		width: 40%;
		padding: 3rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.post-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.post-card:hover {
		transform: translateY(-8px);
		border-color: var(--primary);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
	}

	.post-card:hover img {
		transform: scale(1.05);
	}

	.content {
		padding: 2rem;
	}

	.meta {
		color: var(--primary);
		font-weight: 600;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
	}

	.title {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	.post-card.featured .title {
		font-size: 2.5rem;
	}

	.excerpt {
		color: var(--text-muted);
		margin-bottom: 2rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		color: var(--primary);
		font-weight: 700;
		display: inline-block;
	}

	@media (max-width: 968px) {
		.post-card.featured {
			flex-direction: column;
		}
		.post-card.featured .image-wrapper,
		.post-card.featured .content {
			width: 100%;
		}
		.post-card.featured .content {
			padding: 2rem;
		}
	}

	@media (max-width: 480px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
		.blog-header h1 {
			font-size: 2.5rem;
		}
	}
</style>
